{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode gzip

	handle /healthz {
		header Cache-Control no-store
		respond "ok" 200
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		header Cache-Control no-cache
		file_server
	}
}
